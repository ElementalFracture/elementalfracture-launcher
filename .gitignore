# Rust / Tauri build output
src-tauri/target/
target-jammy/
src-tauri/gen/

# Packaged binaries (built by CI / release, not tracked)
dist/
node_modules/

# tauri-specta TypeScript bindings (ui/generated/bindings.ts) are committed:
# every debug run rewrites them and `cargo test bindings_are_current` keeps
# the committed copy honest.

# Editor and agent state, personal to whoever's working here. Claude Code's
# settings.json is shared on purpose; only the local overrides are ignored.
.idea/
.claude/

# Build artifacts
*.AppImage

# Generated by scripts/build-msi.sh (regenerated each build)
packaging/wixui/ui/License.rtf
packaging/wixui/ui/bitmaps/
*.msi
*.exe

# Release staging (scripts/release.sh, scripts/sign-manifest.sh). Outside dist/,
# which `npm run build` empties on every cargo tauri build.
staging/
